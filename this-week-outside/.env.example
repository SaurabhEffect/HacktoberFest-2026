# Copy to .env and export, or just set these in your shell. All optional.

# --- Local AI (default: Ollama) ---
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=120

# --- Or any OpenAI-compatible local server (llama.cpp, LM Studio, vLLM) ---
# LLM_BACKEND=openai
# LLM_BASE_URL=http://localhost:8080
# LLM_MODEL=local-model

# --- Server ---
HOST=127.0.0.1
PORT=5000

# Identify yourself politely to the free data APIs
# APP_USER_AGENT=my-field-guide/1.0 (https://github.com/you/this-week-outside)
